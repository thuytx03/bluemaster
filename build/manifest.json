{
  "name": "Xthuy Social",
  "description": "Bộ công cụ mạng xã hội đa năng: tải video/ảnh, gửi tin nhắn hàng loạt, lên lịch, quét UID, hỗ trợ Facebook, X, Instagram...",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "logo-rounded.png",
    "32": "logo-rounded.png",
    "48": "logo-rounded.png",
    "128": "logo-rounded.png"
  },
  "action": {
    "default_icon": "logo-rounded.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "src/contentScript/index.dev.tsx-loader.js"
      ],
      "matches": [
        "https://www.facebook.com/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*.js",
        "*.css",
        "public/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "**/*",
        "*"
      ],
      "use_dynamic_url": false
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "bookmarks",
    "identity",
    "cookies",
    "tabs",
    "storage",
    "activeTab",
    "webRequest",
    "notifications",
    "clipboardWrite",
    "declarativeNetRequest"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
