{
  "name": "xthuy-social",
  "displayName": "Xthuy Social",
  "version": "1.0.0",
  "description": "Bộ công cụ mạng xã hội đa năng: tải video/ảnh, gửi tin nhắn hàng loạt, lên lịch, quét UID, hỗ trợ Facebook, X, Instagram...",
  "author": "Trịnh Xuân Thuỷ",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build --zip && mv build/chrome-mv3-prod.zip xthuy_social_extension.zip",
    "package": "plasmo package",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.23.0",
    "@ant-design/icons": "~5.6.1",
    "@fast-csv/format": "^5.0.2",
    "@types/file-saver": "^2.0.7",
    "antd": "^5.24.4",
    "axios": "^1.8.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "emoji-picker-react": "^4.12.2",
    "fast-csv": "^5.0.2",
    "file-saver": "^2.0.5",
    "jquery": "^3.7.1",
    "lucide-react": "^0.539.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.4.0",
    "react-type-animation": "^3.2.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "3.4.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/jquery": "^3.5.32",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "sass": "^1.86.0",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "cookies",
      "downloads",
      "webRequest",
      "webRequestBlocking",
      "declarativeNetRequest",
      "<all_urls>",
      "activeTab",
      "scripting",
      "tabs",
      "storage",
      "notifications",
      "alarms"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "*.js",
          "*.css",
          "public/*"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    }
  }
}
