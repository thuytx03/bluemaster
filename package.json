{
  "name": "bluemaster",
  "displayName": "Bluemaster for Facebook",
  "version": "1.0.2",
  "description": "Open-source browser extension toolkit for Facebook: bulk photo/video/reel/story downloads, multi-URL downloads, UID scraping, bulk inbox messaging, access tokens and cookie tools.",
  "author": "Trịnh Xuân Thuỷ",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "homepage": "https://github.com/thuytx03/bluemaster",
  "repository": {
    "type": "git",
    "url": "https://github.com/thuytx03/bluemaster.git"
  },
  "bugs": {
    "url": "https://github.com/thuytx03/bluemaster/issues"
  },
  "keywords": [
    "facebook",
    "chrome-extension",
    "browser-extension",
    "downloader",
    "plasmo",
    "react",
    "typescript"
  ],
  "alias": {
    "src": "./src"
  },
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build --zip",
    "package": "plasmo package",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "check": "npm run type-check && npm run lint",
    "version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "axios": "^1.8.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "emoji-picker-react": "^4.12.2",
    "file-saver": "^2.0.5",
    "i18next": "^25.4.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "jquery": "^3.7.1",
    "lucide-react": "^0.541.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^15.7.1",
    "react-router-dom": "^7.4.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "3.4.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/file-saver": "^2.0.7",
    "@types/jquery": "^3.5.32",
    "@types/node": "26.6.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "baseline-browser-mapping": "^2.10.21",
    "oxlint": "^1.90.0",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "externally_connectable": {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ]
    },
    "permissions": [
      "cookies",
      "downloads",
      "webRequest",
      "declarativeNetRequest",
      "activeTab",
      "tabs",
      "storage",
      "unlimitedStorage",
      "alarms",
      "notifications"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "*.js",
          "*.css",
          "public/*"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    }
  }
}
